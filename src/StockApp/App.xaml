<prism:PrismApplication x:Class="StockApp.App"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:prism="http://prismlibrary.com/">
    <Application.Resources>
        <ResourceDictionary>
            <!-- 색상 팔레트 (다크 테마) -->
            <Color x:Key="BackgroundColor">#FF0F1419</Color>
            <Color x:Key="SurfaceColor">#FF1A222C</Color>
            <Color x:Key="SurfaceAltColor">#FF22303C</Color>
            <Color x:Key="ForegroundColor">#FFE6EDF3</Color>
            <Color x:Key="MutedForegroundColor">#FF8B98A5</Color>
            <Color x:Key="AccentColor">#FF58A6FF</Color>
            <Color x:Key="UpColor">#FFFF6B6B</Color>
            <Color x:Key="DownColor">#FF4DABF7</Color>
            <Color x:Key="ErrorColor">#FFE5534B</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
            <SolidColorBrush x:Key="ForegroundBrush" Color="{StaticResource ForegroundColor}" />
            <SolidColorBrush x:Key="MutedForegroundBrush" Color="{StaticResource MutedForegroundColor}" />
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <SolidColorBrush x:Key="UpBrush" Color="{StaticResource UpColor}" />
            <SolidColorBrush x:Key="DownBrush" Color="{StaticResource DownColor}" />
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
        </ResourceDictionary>
    </Application.Resources>
</prism:PrismApplication>
